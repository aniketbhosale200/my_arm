  <!-- Define mesh_path if not already defined -->
  <!-- <xacro:property name="mesh_path" value="package://xaarm/meshes" /> -->
  <!-- G Camera Link -->
  <link name="g_camera">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.0088 0 0"/>
      <mass value="0.0208"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/imbatman/arm_ws/src/aarm/meshes/g_camera.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.7922 0.8196 0.9333 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.05"/>
        <!-- Simplified for efficiency -->
      </geometry>
    </collision>
  </link>
  <!-- Joint to attach camera to gripper_base -->
  <joint name="g_camera_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.0002 0.0329 0.0612"/>
    <parent link="gripper_base"/>
    <child link="g_camera"/>
  </joint>
  <!-- Optical Frame for correct point cloud orientation -->
  <link name="g_camera_optical"/>
  <joint name="g_camera_optical_joint" type="fixed">
    <parent link="g_camera"/>
    <child link="g_camera_optical"/>
    <origin rpy="-1.5708 -1.5708 0" xyz="0 0 0"/>
  </joint>
  <gazebo reference="g_camera">
    <sensor name="g_rgbd_camera" type="depth">
      <always_on>true</always_on>
      <pose>0 0 0 0 1.5708 0</pose>
      <!-- Rotate sensor -90° around Y -->
      <update_rate>30.0</update_rate>
      <!-- 30 Hz -->
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <!-- ~60 degrees -->
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <!-- 10 cm -->
          <far>8.0</far>
          <!-- 10 m -->
        </clip>
        <depth_camera/>
      </camera>
      <plugin filename="libgazebo_ros_camera.so" name="g_rgbd_camera_controller">
        <ros>
          <cameraName>g_rgbd_camera</cameraName>
          <imageTopicName>/g_rgbd_camera/color/image_raw</imageTopicName>
          <depthImageTopicName>/g_rgbd_camera/depth/image_raw</depthImageTopicName>
          <pointCloudTopicName>/g_rgbd_camera/depth/points</pointCloudTopicName>
          <cameraInfoTopicName>/g_rgbd_camera/color/camera_info</cameraInfoTopicName>
          <depthCameraInfoTopicName>/g_rgbd_camera/depth/camera_info</depthCameraInfoTopicName>
        </ros>
        <frame_name>g_camera_optical</frame_name>
      </plugin>
    </sensor>
  </gazebo>
  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>/home/imbatman/arm_ws/src/aarm/config/controllers.yaml</parameters>
      <robot_namespace>/aarm</robot_namespace>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="libgazebo_mimic_joint_plugin.so" name="mimic_joint_plugin">
      <joint>left_gripper_arm_joint</joint>
      <mimicJoint>right_gripper_arm_joint</mimicJoint>
      <multiplier>1.0</multiplier>
      <offset>0.0</offset>
      <sensitiveness>0.0</sensitiveness>
      <maxEffort>2.0</maxEffort>
      <hasPID/>
    </plugin>
  </gazebo>
  <gazebo reference="aarm_base_link">
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="link_1">
    <material>Gazebo/Blue</material>
  </gazebo>
